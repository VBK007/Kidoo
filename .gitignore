### Secrets — never commit ###
# Firebase service-account keys. These grant admin access to the Firebase
# project; a leaked one cannot be rotated by changing a password.
secrets/
*firebase-adminsdk*.json
*serviceAccount*.json

# File-backed H2 for the dev (h2) profile — local data, never committed.
/data/
*.mv.db
*.trace.db

# Local junk — crash dumps and ad-hoc device screenshots.
*.stackdump
tower-device-screen.png
