FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium chromium-sandbox util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 worker \
    && install -d -m 0700 -o worker -g worker /run/kidoo-recovery /var/lib/kidoo-worker
COPY tools/netmirror-capture/recovery-worker.mjs /app/recovery-worker.mjs
USER 1001:1001
ENV HOME=/home/worker
ENTRYPOINT ["flock", "--no-fork", "--nonblock", "/var/lib/kidoo-worker/worker.lock", "node", "/app/recovery-worker.mjs"]
